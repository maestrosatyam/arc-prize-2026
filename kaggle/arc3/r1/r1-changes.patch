@@ -0,0 +1,422 @@
+"""R1 recovery pilot runner: replay a recorded prefix, restore the conversation,
+play one arm under a fixed budget; case-major over (case, arm) with a thread pool.
+
+Used by the Kaggle notebook (arc-agi-3-r1-recovery-pilot) and by the offline
+dry run (scripts/arc3_recovery_dryrun.py) with a scripted analyzer.
+"""
+from __future__ import annotations
+
+import base64
+import gzip
+import hashlib
+import io
+import json
+import tarfile
+import threading
+import time
+import traceback
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any, Callable
+
+import arcengine
+import arc_agi
+import taaf.game
+import taaf.game_api
+
+from inference.agent import r1_recovery as _r1
+from inference.agent.runtime_state import RUNTIME_STATE_FILENAME
+from inference.framework.solver import _HarnessGameSession, _grid_from_state, _level_number
+
+ARMS = ("A0", "A1", "A2")          # R1
+R1B_ARMS = ("A0b", "A3")           # R1b: second A0 sample, fresh continuation
+R1C_ARMS = ("A4", "A5")            # R1c: dose-matched trim of the restored history, no retained functions
+R1E_ARMS = ("A6", "A0c")           # R1e: repertoire sweep, third A0 sample
+ALL_ARMS = ARMS + R1B_ARMS + R1C_ARMS + R1E_ARMS
+DEFAULT_ACTION_BUDGET = 80
+DEFAULT_WALL_BUDGET_S = 15 * 60
+
+RESULT_FIELDS = (
+    "case_id", "arm", "game_id", "target_level", "cut", "cleared", "actions_used", "generated_tokens",
+    "wall_s", "probes", "readbacks", "batches", "capped_batches", "timeouts", "cancelled_actions",
+    "notice_shown", "fresh_notice_shown", "end_reason", "turns", "levels_completed_end", "final_state", "solver_note",
+    "replay_ok", "replay_s", "restore_history_messages", "kept_functions", "prelude_error", "started_utc", "error",
+    "restore_history_before_trim", "restore_tokens_before_trim", "restore_tokens_after_trim", "trim_keep_fraction",
+    "clear_actions", "clear_wall_s", "repertoire_shown", "repertoire_chars_max", "repertoire_errors",
+)
+STAT_FIELDS = ("probes", "readbacks", "batches", "capped_batches", "timeouts", "cancelled_actions",
+               "notice_shown", "fresh_notice_shown", "repertoire_shown", "repertoire_chars_max", "repertoire_errors")
+
+
+# ----------------------------------------------------------------------------
+# bundle
+
+def load_bundle_text(b64_text: str) -> dict[str, dict[str, Any]]:
+    raw = base64.b64decode("".join(b64_text.split()))
+    return load_bundle_bytes(raw)
+
+
+def load_bundle_bytes(gz_bytes: bytes) -> dict[str, dict[str, Any]]:
+    cases: dict[str, dict[str, Any]] = {}
+    with tarfile.open(fileobj=io.BytesIO(gzip.decompress(gz_bytes)), mode="r") as tar:
+        for member in tar.getmembers():
+            if not member.isfile():
+                continue
+            cid, name = member.name.split("/", 1)
+            data = tar.extractfile(member).read()
+            case = cases.setdefault(cid, {"case_id": cid})
+            if name == "meta.json":
+                case["meta"] = json.loads(data)
+            elif name == "prefix_actions.json":
+                case["prefix"] = json.loads(data)
+            elif name == "restore.json":
+                case["restore"] = json.loads(data)
+            elif name == "prelude.py":
+                case["prelude"] = data.decode("utf-8")
+    for cid, case in cases.items():
+        for key in ("meta", "prefix", "restore", "prelude"):
+            if key not in case:
+                raise ValueError(f"bundle case {cid} lacks {key}")
+    return cases
+
+
+def load_cases_dir(path: Path) -> dict[str, dict[str, Any]]:
+    cases: dict[str, dict[str, Any]] = {}
+    for d in sorted(p for p in Path(path).iterdir() if p.is_dir()):
+        cases[d.name] = {
+            "case_id": d.name,
+            "meta": json.loads((d / "meta.json").read_text()),
+            "prefix": json.loads((d / "prefix_actions.json").read_text()),
+            "restore": json.loads((d / "restore.json").read_text()),
+            "prelude": (d / "prelude.py").read_text(),
+        }
+    return cases
+
+
+# ----------------------------------------------------------------------------
+# game construction and replay
+
+_GAME_LOCK = threading.Lock()
+
+
+def offline_game(env_dir: str, game_id: str, run_session: taaf.game.RunSession) -> taaf.game_api.GameAPI:
+    spec = taaf.game_api.ArcadeSpec(operation_mode=arc_agi.OperationMode.OFFLINE, environments_dir=env_dir)
+    game = taaf.game_api.GameAPI(env_name=game_id, arcade_spec=spec)
+    with _GAME_LOCK:
+        game.start_game(run_session)
+    return game
+
+
+def replay_prefix(session: _HarnessGameSession, prefix: list[dict[str, Any]]) -> None:
+    """Replay recorded actions through the session so history, viewer events
+    and runtime state come out as they did in P0; no tokens are charged.
+
+    The runtime-state file and the viewer payload (with its events sidecar)
+    are written once, after the last replayed action, instead of per action:
+    the state file grows with the prefix, so per-action rewrites made the
+    replay quadratic in the prefix length. The files that result are the same.
+    """
+    previous = session.r1_defer_state_writes
+    session.r1_defer_state_writes = True
+    try:
+        for a in prefix:
+            action = arcengine.ActionInput(id=getattr(arcengine.GameAction, a["name"]), data=dict(a.get("data") or {}))
+            session._execute_action(action, batch_index=1, batch_size=1, generated_tokens=0, flush_viewer_payload=False)
+    finally:
+        session.r1_defer_state_writes = previous
+    session.write_runtime_state()
+    session.write_viewer_payload()
+
+
+def board_hash(session: _HarnessGameSession) -> str:
+    grid = [list(row) for row in _grid_from_state(session.game.current_state)]
+    return hashlib.sha256(json.dumps(grid).encode()).hexdigest()[:16]
+
+
+# ----------------------------------------------------------------------------
+# one case-arm
+
+def run_case_arm(
+    *,
+    solver: Any,
+    case: dict[str, Any],
+    arm: str,
+    index: int,
+    job_dir: Path,
+    env_dir: str,
+    run_session: taaf.game.RunSession,
+    analyzer_factory: Callable[[Any, int], Any],
+    stop_event: threading.Event,
+    action_budget: int = DEFAULT_ACTION_BUDGET,
+    wall_budget_s: float = DEFAULT_WALL_BUDGET_S,
+    arm_flags: dict[str, dict[str, str]] | None = None,
+) -> dict[str, Any]:
+    arm_flags = arm_flags or _r1.ARM_FLAGS
+    meta = case["meta"]
+    cid = case["case_id"]
+    result: dict[str, Any] = {k: None for k in RESULT_FIELDS}
+    result.update({
+        "case_id": cid, "arm": arm, "game_id": meta["game_id"], "target_level": int(meta["target_level"]),
+        "cut": int(meta["cut"]), "cleared": False, "actions_used": 0, "generated_tokens": 0, "wall_s": 0.0,
+        "started_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "replay_ok": False,
+    })
+    stem = f"{cid}_{arm}"
+    artifacts = job_dir / "artifacts"
+    transcripts = job_dir / "transcripts"
+    artifacts.mkdir(parents=True, exist_ok=True)
+    transcripts.mkdir(parents=True, exist_ok=True)
+    state_path = artifacts / f"{stem}_{RUNTIME_STATE_FILENAME}"
+    viewer_data_path = artifacts / f"{stem}_viewer_data.json"
+    transcript_path = transcripts / f"{stem}.txt"
+    analysis_relpath = f"solver_analysis/{stem}.html"
+
+    game = None
+    session = None
+    turns_before = 0
+    t_start = time.monotonic()
+    try:
+        game = offline_game(env_dir, meta["game_id"], run_session)
+        analyzer = analyzer_factory(game, index)
+        analyzer._r1_flags = dict(arm_flags[arm])
+        session = _HarnessGameSession(
+            solver=solver, game=game, analyzer=analyzer, game_index=index, pass_index=0,
+            state_path=state_path, transcript_path=transcript_path, analysis_html_relpath=analysis_relpath,
+            stop_event=stop_event, viewer_data_path=viewer_data_path,
+        )
+        session._append_initial_viewer_event()
+        t_replay = time.monotonic()
+        replay_prefix(session, case["prefix"])
+        result["replay_s"] = round(time.monotonic() - t_replay, 1)
+        replay_ok = (
+            session.action_count == int(meta["cut"])
+            and board_hash(session) == meta.get("board_hash_at_cut")
+            and _level_number(game) == int(meta.get("level_at_cut") or meta["target_level"])
+        )
+        result["replay_ok"] = bool(replay_ok)
+        if not replay_ok:
+            result["end_reason"] = "replay_mismatch"
+            result["error"] = (f"replay mismatch: actions={session.action_count} board={board_hash(session)} "
+                               f"level={_level_number(game)}")
+            return result
+
+        if _r1.r1_bool(analyzer, "ARC3_R1_FRESH_START"):
+            # A3: same board, empty conversation, no prelude
+            history, kept, prelude_error = [], {}, ""
+        elif _r1.r1_bool(analyzer, "ARC3_R1_NO_PRELUDE"):
+            # A5: full conversation, no retained functions
+            history, kept, prelude_error = case["restore"], {}, ""
+        else:
+            history = case["restore"]
+            kept, prelude_error = _r1.seed_kept_functions(case["prelude"])
+        _r1.restore_agent(analyzer, state_path, history, kept, actions_at_level_start=int(meta["a_start"]))
+        if _r1.r1_bool(analyzer, "ARC3_R1_TRIM_RESTORE"):
+            # A4: the restored conversation cut to the share of messages a P0 trim keeps
+            trim = _r1.trim_restored_history(analyzer, state_path)
+            result["restore_history_before_trim"] = trim["messages_before"]
+            result["restore_tokens_before_trim"] = trim["tokens_before"]
+            result["restore_tokens_after_trim"] = trim["tokens_after"]
+            result["trim_keep_fraction"] = trim["keep_fraction"]
+        result["restore_history_messages"] = len(analyzer._history_messages)
+        result["kept_functions"] = len(kept)
+        result["prelude_error"] = prelude_error or None
+        session.analysis_step = max(0, int(meta.get("restore_analysis_step") or 1) - 1)
+        turns_before = session.analysis_step
+
+        session.started_at = time.monotonic()
+        session.r1_action_limit = int(meta["cut"]) + int(action_budget)
+        session.r1_deadline = session.started_at + float(wall_budget_s)
+        session.r1_target_level = int(meta["target_level"])
+        t_start = session.started_at
+        _mark_clear(session, result, int(meta["cut"]), int(meta["target_level"]))
+        session.play()
+    except Exception as exc:  # noqa: BLE001
+        result["error"] = f"{type(exc).__name__}: {exc}\n{traceback.format_exc()[-2000:]}"
+        result["end_reason"] = result["end_reason"] or "error"
+    finally:
+        result["wall_s"] = round(time.monotonic() - t_start, 1)
+        if session is not None and game is not None and game.game_run is not None:
+            run = game.game_run
+            stats = getattr(session.analyzer, "_r1_stats", None) or _r1.new_stats()
+            cleared = bool(run.state == "won" or int(run.levels_completed) >= int(meta["target_level"]))
+            result.update({
+                "cleared": cleared,
+                "actions_used": max(0, session.action_count - int(meta["cut"])),
+                "generated_tokens": int(getattr(session.analyzer, "generated_tokens", 0) or 0),
+                "turns": max(0, int(session.analysis_step) - int(turns_before)),
+                "levels_completed_end": int(run.levels_completed),
+                "final_state": run.state,
+                "solver_note": run.solver_note,
+                **{k: int(stats.get(k, 0)) for k in STAT_FIELDS},
+            })
+            if result["end_reason"] is None:
+                reason = session.r1_end_reason
+                if reason is None and cleared:
+                    reason = "cleared"
+                elif reason is None and stop_event.is_set():
+                    reason = "hard_stop"
+                elif reason is None and result["wall_s"] >= float(wall_budget_s):
+                    reason = "wall_budget"
+                elif reason is None and str(run.solver_note or "").startswith("error"):
+                    reason = "error"
+                result["end_reason"] = reason or "loop_exit"
+            if run.final_score is None:
+                try:
+                    game.finish_game()
+                except Exception:  # noqa: BLE001
+                    pass
+    return result
+
+
+def _mark_clear(session: _HarnessGameSession, result: dict[str, Any], cut: int, target_level: int) -> None:
+    """Record actions after the cut and seconds after the restore at the action
+    that clears the target level (clear_actions, clear_wall_s). wall_s is taken
+    when the case-arm ends, which can be later than the clear."""
+    execute = session._execute_action
+
+    def execute_and_mark(*args: Any, **kwargs: Any) -> dict[str, Any]:
+        payload = execute(*args, **kwargs)
+        if result.get("clear_wall_s") is None:
+            state = session.game.current_state
+            if state.won or int(state.levels_completed) >= target_level:
+                result["clear_wall_s"] = round(time.monotonic() - session.started_at, 1)
+                result["clear_actions"] = max(0, session.action_count - cut)
+        return payload
+
+    session._execute_action = execute_and_mark
+
+
+# ----------------------------------------------------------------------------
+# the pilot
+
+def run_pilot(
+    *,
+    solver: Any,
+    cases: dict[str, dict[str, Any]],
+    job_dir: Path,
+    env_dir: str,
+    results_path: Path,
+    analyzer_factory: Callable[[Any, int], Any] | None = None,
+    arms: tuple[str, ...] = ARMS,
+    concurrency: int = 10,
+    action_budget: int = DEFAULT_ACTION_BUDGET,
+    wall_budget_s: float = DEFAULT_WALL_BUDGET_S,
+    hard_stop_monotonic: float | None = None,
+    case_order: list[str] | None = None,
+    arm_flags: dict[str, dict[str, str]] | None = None,
+    log: Callable[[str], None] = print,
+) -> list[dict[str, Any]]:
+    """Case-major over arms; results appended to results_path as they finish."""
+    job_dir = Path(job_dir)
+    job_dir.mkdir(parents=True, exist_ok=True)
+    artifacts = job_dir / "artifacts"
+    artifacts.mkdir(parents=True, exist_ok=True)
+    # keeps the artifacts dir at >= 2 runtime-state files so the agent's request
+    # log resolves to the per-game name even when a single game is running
+    (artifacts / f"_r1_keepalive_{RUNTIME_STATE_FILENAME}").write_text("{}")
+
+    if analyzer_factory is None:
+        def analyzer_factory(game, index):  # noqa: ANN001
+            return solver._make_analyzer(game, index, solver._local_server_for_game_index(index))
+
+    solver.max_runtime_s_per_game = float(wall_budget_s)
+    solver.max_actions_per_game = None
+    solver._warmup_remaining = 0
+    if hard_stop_monotonic is not None:
+        remaining = max(0.0, hard_stop_monotonic - time.monotonic())
+        solver.soft_end_time = datetime.now() + timedelta(seconds=remaining)
+    stop_event = solver._stop_event
+    stop_event.clear()
+    run_session = taaf.game.RunSession(record_intermediate_states=False)
+
+    order = case_order or sorted(cases)
+    jobs = [(cid, arm) for cid in order for arm in arms]
+    results: list[dict[str, Any]] = []
+    lock = threading.Lock()
+    results_path = Path(results_path)
+    results_path.parent.mkdir(parents=True, exist_ok=True)
+    results_path.write_text("")
+
+    def watchdog() -> None:
+        while hard_stop_monotonic is not None and not stop_event.is_set():
+            if time.monotonic() >= hard_stop_monotonic:
+                log("[r1] hard stop reached; stopping sessions")
+                stop_event.set()
+                return
+            time.sleep(5)
+
+    if hard_stop_monotonic is not None:
+        threading.Thread(target=watchdog, daemon=True).start()
+
+    def one(index: int, cid: str, arm: str) -> dict[str, Any]:
+        if hard_stop_monotonic is not None and time.monotonic() >= hard_stop_monotonic or stop_event.is_set():
+            res = {k: None for k in RESULT_FIELDS}
+            res.update({"case_id": cid, "arm": arm, "game_id": cases[cid]["meta"]["game_id"],
+                        "target_level": cases[cid]["meta"]["target_level"], "cut": cases[cid]["meta"]["cut"],
+                        "cleared": False, "actions_used": 0, "generated_tokens": 0, "wall_s": 0.0,
+                        "end_reason": "skipped_hard_stop"})
+            return res
+        log(f"[r1] start {cid} {arm} ({index + 1}/{len(jobs)})")
+        res = run_case_arm(
+            solver=solver, case=cases[cid], arm=arm, index=index, job_dir=job_dir, env_dir=env_dir,
+            run_session=run_session, analyzer_factory=analyzer_factory, stop_event=stop_event,
+            action_budget=action_budget, wall_budget_s=wall_budget_s, arm_flags=arm_flags,
+        )
+        return res
+
+    def record(res: dict[str, Any]) -> None:
+        with lock:
+            results.append(res)
+            with open(results_path, "a", encoding="utf-8") as f:
+                f.write(json.dumps(res, ensure_ascii=True) + "\n")
+        log(f"[r1] done {res['case_id']} {res['arm']}: cleared={res['cleared']} actions={res['actions_used']} "
+            f"tokens={res['generated_tokens']} wall={res['wall_s']}s end={res['end_reason']}"
+            + (f" error={str(res['error'])[:120]!r}" if res.get("error") else ""))
+
+    with ThreadPoolExecutor(max_workers=max(1, int(concurrency)), thread_name_prefix="r1-case") as pool:
+        futures = [pool.submit(one, i, cid, arm) for i, (cid, arm) in enumerate(jobs)]
+        for fut in futures:
+            try:
+                record(fut.result())
+            except Exception as exc:  # noqa: BLE001
+                record({**{k: None for k in RESULT_FIELDS}, "case_id": "?", "arm": "?", "cleared": False,
+                        "end_reason": "error", "error": f"{type(exc).__name__}: {exc}"})
+    try:
+        run_session.close()
+    except Exception:  # noqa: BLE001
+        pass
+    return results
+
+
+def summary_table(results: list[dict[str, Any]], arms: tuple[str, ...] | None = None) -> str:
+    by_case: dict[str, dict[str, dict[str, Any]]] = {}
+    for r in results:
+        by_case.setdefault(str(r.get("case_id")), {})[str(r.get("arm"))] = r
+    if arms is None:
+        seen = {str(r.get("arm")) for r in results}
+        arms = tuple(a for a in ALL_ARMS if a in seen) + tuple(sorted(seen - set(ALL_ARMS))) or ARMS
+    lines = []
+    head = f"{'case':<16}" + "".join(f"{arm + ' clr/act/tok/end':<30}" for arm in arms)
+    lines.append(head)
+    for cid in sorted(by_case):
+        row = f"{cid:<16}"
+        for arm in arms:
+            r = by_case[cid].get(arm)
+            if r is None:
+                row += f"{'-':<30}"
+            else:
+                cell = f"{'Y' if r.get('cleared') else 'n'}/{r.get('actions_used')}/{r.get('generated_tokens')}/{r.get('end_reason')}"
+                row += f"{cell:<30}"
+        lines.append(row)
+    lines.append("")
+    for arm in arms:
+        rs = [r for r in results if r.get("arm") == arm and r.get("end_reason") not in ("skipped_hard_stop", None)]
+        n = len(rs)
+        c = sum(1 for r in rs if r.get("cleared"))
+        acts = sorted(int(r.get("actions_used") or 0) for r in rs if r.get("cleared"))
+        med = acts[len(acts) // 2] if acts else None
+        lines.append(f"{arm}: cleared {c}/{n}; median actions to clear {med}; "
+                     f"timeouts {sum(int(r.get('timeouts') or 0) for r in rs)}; "
+                     f"probes {sum(int(r.get('probes') or 0) for r in rs)}; "
+                     f"errors {sum(1 for r in rs if r.get('error'))}")
+    return "\n".join(lines)

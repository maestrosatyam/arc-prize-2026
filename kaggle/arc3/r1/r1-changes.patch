index 0000000..9b143f8
--- /dev/null
+++ b/ARC3-Inference/inference/agent/r1_repertoire.py
@@ -0,0 +1,377 @@
+"""R1e, arm A6 (repertoire sweep): the action effects the agent has observed in this game, read off the
+harness's own action log, and the message that asks the agent to look for new uses of them.
+
+Generic for any ARC-AGI-3 game. The only inputs are what the agent was shown: the board after every action
+(the events log / runtime-state history of this game), the action name (for a click, the colour letter of
+the clicked cell on the board before the click), the level after every action, the engine's level-complete
+and game-over flags, and the animation notes in the conversation. Nothing comes from game source or rules.
+
+Per action the board before and after are compared colour by colour, in the letters the agent sees:
+  - the background (most frequent colour on the board before) is never described;
+  - two colours that trade cells both ways (an object moving over a floor) are one mover: the colour with
+    fewer cells on the board after is the object, the other is not described;
+  - cells of colour x that became colour y with no y -> x cells in the same step: "x turns y";
+  - any other change of a colour: "moves <direction>" (cells lost and gained in similar numbers, centroid
+    shifted by at least one cell), "appears", "disappears", "grows", "shrinks", or "changes shape";
+  - no changed cell: "no change"; more than half the board changed: "most of the board changes";
+  - an action that completes a level, ends the game (game over), or returns the board to the level's
+    starting board is counted as that event and not described cell by cell.
+A description present after at least 70% of the actions of the game (at least 10 actions, under two or more
+action names) follows any action (a step counter, a timer); it is listed once as "Every action" and dropped
+from the per-action lines.
+
+Message: at most MAX_CHARS characters (on the 35 R1 cases 714-898 characters, 229-323 tokens with the Qwen2.5
+tokenizer); the observation block is shortened (fewer effects per action, fewer clicked colours listed one by
+one) until it fits, and the request at its end is never cut.
+"""
+from __future__ import annotations
+
+import math
+import re
+from collections import Counter
+from typing import Any, Iterable
+
+import numpy as np
+
+try:
+    from inference.utils.grid_utils import ARC_COLOR_CHARS
+except Exception:  # noqa: BLE001  (tests may import this module on its own)
+    ARC_COLOR_CHARS = "WwgGcBMPRbSYOrNp"
+
+SWEEP_EVERY = 25          # actions on the current level between two sweeps
+MAX_CHARS = 900           # message cap; letter lists tokenise at about 2.7-3.0 characters per token
+CHARS_PER_TOKEN = 2.6     # conservative: the lowest ratio measured on these messages (Qwen2.5 BPE) rounded down
+CLOCK_SHARE = 0.7
+CLOCK_MIN_ACTIONS = 10
+MOUSE_RE = re.compile(r"MOUSE\(row=(-?\d+), col=(-?\d+)\)")
+ANIM_RE = re.compile(r"(?:The last executed action \(`([^`]+)`\)|(That fatal action)) animated over \d+ frames")
+ACTION_ORDER = ("UP", "DOWN", "LEFT", "RIGHT", "SPACE", "MOUSE", "UNDO")
+
+HEADER = ("Repertoire check. Effects seen in this game so far, from the action log "
+          "(letters = board colours; n/m = all levels/this level):")
+ASK = ("Before acting, write down every way each mechanic above could be used differently on this level: a new "
+       "role, a new combination or order, an object not touched yet. Mark the ones already tested on this level. "
+       "Then run the cheapest untested one as a short probe and read back the board.")
+
+
+def _letter(v: Any) -> str:
+    return ARC_COLOR_CHARS[max(0, min(15, int(v)))]
+
+
+# ----------------------------------------------------------------------------
+# records: one per board, in action order
+
+def _board_of(ev: dict[str, Any]) -> Any:
+    if ev.get("board") is not None:
+        return ev["board"]
+    text = ev.get("board_ascii")
+    if not isinstance(text, str) or not text:
+        return None
+    index = {ch: i for i, ch in enumerate(ARC_COLOR_CHARS)}
+    return [[index.get(ch, 0) for ch in line] for line in text.split("\n")]
+
+
+def records_from_events(events: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Viewer events of a game (the session's ``viewer_events``, also written to the ``*_events.jsonl``
+    sidecar): the initial board and one per action. ``board`` (numbers) or ``board_ascii`` (letters)."""
+    out: list[dict[str, Any]] = []
+    for ev in events:
+        kind = ev.get("type")
+        board = _board_of(ev) if kind in ("initial", "action") else None
+        if board is None:
+            continue
+        out.append({
+            "action": None if kind == "initial" else str(ev.get("action_display") or ev.get("action_name") or "?"),
+            "board": board,
+            "level": int(ev.get("level") or 1),
+            "level_completed": bool(ev.get("level_completed")),
+            "game_over": bool(ev.get("game_over")),
+        })
+    return out
+
+
+def records_from_history(entries: Iterable[Any]) -> list[dict[str, Any]]:
+    """Runtime-state history entries (``HistoryEntry``: action, frame, result); no initial board."""
+    out: list[dict[str, Any]] = []
+    for e in entries:
+        result = getattr(e, "result", None) or {}
+        out.append({
+            "action": str(getattr(e, "action", "") or result.get("action_display") or "?"),
+            "board": e.frame.grid,
+            "level": int(e.frame.level or 1),
+            "level_completed": bool(result.get("level_completed")),
+            "game_over": bool(result.get("game_over")),
+        })
+    return out
+
+
+# ----------------------------------------------------------------------------
+# one action
+
+def action_key(action: str, before: np.ndarray | None) -> str:
+    m = MOUSE_RE.fullmatch(action.strip())
+    if m:
+        r, c = int(m.group(1)), int(m.group(2))
+        if before is not None and 0 <= r < before.shape[0] and 0 <= c < before.shape[1]:
+            return f"MOUSE on {_letter(before[r, c])}"
+        return "MOUSE"
+    return action.strip().upper() or "?"
+
+
+def _direction(dr: float, dc: float) -> str:
+    vert = "down" if dr > 0 else "up"
+    horiz = "right" if dc > 0 else "left"
+    if abs(dr) >= 2 * abs(dc):
+        return vert
+    if abs(dc) >= 2 * abs(dr):
+        return horiz
+    return f"{vert}-{horiz}"
+
+
+def board_effects(before: np.ndarray, after: np.ndarray) -> tuple[set[str], set[str]]:
+    """(descriptions, colour letters of every changed cell before or after) for one action."""
+    if before.shape != after.shape:
+        return {"board changes size"}, set()
+    diff = before != after
+    n = int(diff.sum())
+    if n == 0:
+        return {"no change"}, set()
+    bv, av = before[diff], after[diff]
+    touched = {_letter(v) for v in np.unique(np.concatenate([bv, av]))}
+    if n > diff.size // 2:
+        return {"most of the board changes"}, touched
+    values, counts = np.unique(before, return_counts=True)
+    bg = int(values[int(np.argmax(counts))])
+    coords = np.argwhere(diff)
+    trans = Counter(zip(bv.tolist(), av.tolist()))
+    count_after = {int(v): int(c) for v, c in zip(*np.unique(after, return_counts=True))}
+    count_before = {int(v): int(c) for v, c in zip(*np.unique(before, return_counts=True))}
+
+    skip = {bg}
+    for (x, y) in trans:
+        if x < y and (y, x) in trans:
+            # two colours trading cells: an object moving over a floor; the larger one is the floor
+            skip.add(x if count_after.get(x, 0) > count_after.get(y, 0) else y)
+    out: set[str] = set()
+    turned_to: dict[int, set[int]] = {}
+    turned_from: dict[int, set[int]] = {}
+    for (x, y) in sorted(trans):
+        if x in skip or y in skip or (y, x) in trans:
+            continue
+        out.add(f"{_letter(x)} turns {_letter(y)}")
+        turned_to.setdefault(x, set()).add(y)
+        turned_from.setdefault(y, set()).add(x)
+    for v in sorted({int(x) for x in np.unique(np.concatenate([bv, av]))} - skip):
+        lost = (bv == v) & ~np.isin(av, list(turned_to.get(v, ())))
+        gained = (av == v) & ~np.isin(bv, list(turned_from.get(v, ())))
+        nl, ng = int(lost.sum()), int(gained.sum())
+        if not nl and not ng:
+            continue
+        name = _letter(v)
+        if nl and ng:
+            d = coords[gained].mean(axis=0) - coords[lost].mean(axis=0)
+            if math.hypot(float(d[0]), float(d[1])) >= 1.0 and min(nl, ng) >= 0.5 * max(nl, ng):
+                out.add(f"{name} moves {_direction(float(d[0]), float(d[1]))}")
+            else:
+                out.add(f"{name} changes shape")
+        elif ng:
+            out.add(f"{name} appears" if count_before.get(v, 0) == 0 else f"{name} grows")
+        else:
+            out.add(f"{name} disappears" if count_after.get(v, 0) == 0 else f"{name} shrinks")
+    return out or {"no change"}, touched
+
+
+# ----------------------------------------------------------------------------
+# the game so far
+
+def observe(records: list[dict[str, Any]], messages: list[dict[str, Any]] | None = None) -> dict[str, Any]:
+    """Per-action observations of the game so far. ``records`` in action order; a record with action None is
+    the initial board. ``messages`` is the conversation (animation notes are read from its user turns)."""
+    steps: list[dict[str, Any]] = []
+    level_start: np.ndarray | None = None
+    prev: dict[str, Any] | None = None
+    prev_board: np.ndarray | None = None
+    for rec in records:
+        board = np.asarray(rec["board"], dtype=np.int16)
+        if rec["action"] is None:
+            prev, prev_board, level_start = rec, board, board
+            continue
+        if prev is None:
+            prev, prev_board, level_start = rec, board, board   # first action without its board before: skip
+            continue
+        level = int(prev["level"])
+        key = action_key(rec["action"], prev_board)
+        step = {"key": key, "level": level, "event": None, "effects": set(), "touched": set()}
+        if key.startswith("MOUSE on "):
+            step["touched"].add(key[-1])
+        if rec["level_completed"] or int(rec["level"]) != level:
+            step["event"] = "level clear" if rec["level_completed"] or int(rec["level"]) > level else "level change"
+            level_start = board
+        elif rec["game_over"]:
+            step["event"] = "game over"
+        elif key == "RESET":
+            step["event"] = "reset"
+            level_start = board
+        elif (level_start is not None and board.shape == level_start.shape and np.array_equal(board, level_start)
+              and not np.array_equal(prev_board, board)):
+            step["event"] = "back to level start"
+        else:
+            effects, touched = board_effects(prev_board, board)
+            step["effects"] = effects
+            step["touched"] |= touched
+        steps.append(step)
+        prev, prev_board = rec, board
+
+    current_level = int(records[-1]["level"]) if records else 1
+    plain = [s for s in steps if s["event"] is None]
+    clock: set[str] = set()
+    if len(plain) >= CLOCK_MIN_ACTIONS:
+        counts = Counter(e for s in plain for e in s["effects"] if e not in ("no change", "most of the board changes"))
+        for eff, c in counts.items():
+            keys = {s["key"] for s in plain if eff in s["effects"]}
+            if c >= CLOCK_SHARE * len(plain) and len(keys) >= 2:
+                clock.add(eff)
+    for s in plain:
+        rest = s["effects"] - clock
+        s["effects"] = rest or {"no change"}
+
+    actions: dict[str, dict[str, Any]] = {}
+    for s in steps:
+        if s["key"] == "RESET":
+            continue
+        a = actions.setdefault(s["key"], {"n": 0, "n_level": 0, "effects": Counter(), "effects_level": Counter()})
+        here = s["level"] == current_level
+        a["n"] += 1
+        a["n_level"] += int(here)
+        for eff in (s["effects"] if s["event"] is None else {s["event"]}):
+            a["effects"][eff] += 1
+            a["effects_level"][eff] += int(here)
+
+    events: dict[str, Counter] = {}
+    for s in steps:
+        if s["event"] in ("level clear", "game over", "back to level start"):
+            events.setdefault(s["event"], Counter())[s["key"]] += 1
+    resets = sum(1 for s in steps if s["key"] == "RESET")
+
+    touched_level: set[str] = set()
+    for s in steps:
+        if s["level"] == current_level:
+            touched_level |= s["touched"]
+    untouched: list[str] = []
+    if records:
+        board = np.asarray(records[-1]["board"], dtype=np.int16)
+        values, counts = np.unique(board, return_counts=True)
+        bg = int(values[int(np.argmax(counts))])
+        untouched = sorted({_letter(v) for v in values if int(v) != bg} - touched_level)
+
+    return {
+        "current_level": current_level,
+        "actions_on_level": actions_on_level(records),
+        "actions": actions,
+        "clock": sorted(clock),
+        "events": events,
+        "resets": resets,
+        "animations": animation_counts(messages or []),
+        "untouched": untouched,
+        "n_steps": len(steps),
+    }
+
+
+def actions_on_level(records: list[dict[str, Any]]) -> int:
+    """Actions taken on the current level: trailing actions that started on it."""
+    n = 0
+    for i in range(len(records) - 1, 0, -1):
+        rec, prev = records[i], records[i - 1]
+        if rec["action"] is None or int(prev["level"]) != int(records[-1]["level"]) or rec["level_completed"]:
+            break
+        n += 1
+    if records and records[0]["action"] is not None and len(records) == n + 1 \
+            and int(records[0]["level"]) == int(records[-1]["level"]) and not records[0]["level_completed"]:
+        n += 1   # history without an initial board: the first action counts too
+    return n
+
+
+def animation_counts(messages: list[dict[str, Any]]) -> Counter:
+    """Animation notes the harness put in the conversation (user turns), by action name."""
+    out: Counter = Counter()
+    for m in messages:
+        if str(m.get("role")) != "user":
+            continue
+        content = m.get("content")
+        if isinstance(content, list):
+            text = "\n".join(str(p.get("text") or "") for p in content if isinstance(p, dict))
+        else:
+            text = str(content or "")
+        for named, fatal in ANIM_RE.findall(text):
+            name = "a fatal action" if fatal else ("MOUSE" if named.startswith("MOUSE") else named.strip().upper())
+            out[name] += 1
+    return out
+
+
+# ----------------------------------------------------------------------------
+# the message
+
+def _order(key: str) -> tuple:
+    base = key.split(" ", 1)[0]
+    return (ACTION_ORDER.index(base) if base in ACTION_ORDER else len(ACTION_ORDER), key)
+
+
+def _action_lines(obs: dict[str, Any], per_action: int, mouse_keys: int) -> list[str]:
+    acts = obs["actions"]
+    mouse = sorted((k for k in acts if k.startswith("MOUSE")), key=lambda k: (-acts[k]["n_level"], -acts[k]["n"], k))
+    shown = [k for k in acts if not k.startswith("MOUSE")] + mouse[:mouse_keys]
+    lines = []
+    for key in sorted(shown, key=_order):
+        a = acts[key]
+        effs = sorted(a["effects"], key=lambda e: (-a["effects_level"][e], -a["effects"][e], e))[:per_action]
+        body = "; ".join(f"{e} {a['effects'][e]}/{a['effects_level'][e]}" for e in effs)
+        lines.append(f"{key} {a['n']}/{a['n_level']}: {body}")
+    rest = mouse[mouse_keys:]
+    if rest:
+        n = sum(acts[k]["n"] for k in rest)
+        nl = sum(acts[k]["n_level"] for k in rest)
+        lines.append(f"MOUSE on other colours ({', '.join(k[-1] for k in rest)}) {n}/{nl}")
+    return lines
+
+
+def _fmt_counter(c: Counter, limit: int = 3) -> str:
+    return ", ".join(f"{k} {v}" for k, v in c.most_common(limit))
+
+
+def render(obs: dict[str, Any], max_chars: int = MAX_CHARS) -> str:
+    tail: list[str] = []
+    if obs["clock"]:
+        tail.append("Every action: " + ", ".join(obs["clock"]) + ".")
+    ev = obs["events"]
+    parts = []
+    for name, label in (("level clear", "level clears"), ("game over", "game overs"), ("back to level start", "back to level start")):
+        if ev.get(name):
+            parts.append(f"{label} {sum(ev[name].values())} ({_fmt_counter(ev[name])})")
+    if obs["resets"]:
+        parts.append(f"RESET {obs['resets']}")
+    if parts:
+        tail.append("Events: " + "; ".join(parts) + ".")
+    if obs["animations"]:
+        tail.append("Animations reported after: " + _fmt_counter(obs["animations"], 4) + ".")
+    if obs["untouched"]:
+        tail.append("On the board, never changed on this level: " + ", ".join(obs["untouched"]) + ".")
+    text = ""
+    for per_action, mouse_keys in ((3, 4), (2, 3), (2, 2), (1, 2), (1, 1)):
+        lines = _action_lines(obs, per_action, mouse_keys) or ["(no action taken yet)"]
+        text = "\n".join([HEADER, *lines, *tail, ASK])
+        if len(text) <= max_chars:
+            return text
+    # still too long: cut the observation block, keep the request whole
+    head = "\n".join([HEADER, *_action_lines(obs, 1, 1), *tail])
+    room = max(0, max_chars - len(ASK) - 5)
+    return head[:room].rstrip() + " ...\n" + ASK
+
+
+def sweep_message(records: list[dict[str, Any]], messages: list[dict[str, Any]] | None = None,
+                  max_chars: int = MAX_CHARS) -> str:
+    return render(observe(records, messages), max_chars=max_chars)
+
+
+def estimate_tokens(text: str) -> int:
+    """Conservative token estimate (CHARS_PER_TOKEN characters per token)."""
+    return int(math.ceil(len(text) / CHARS_PER_TOKEN))

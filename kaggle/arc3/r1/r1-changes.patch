diff --git a/ARC3-Inference/inference/agent/r1_recovery.py b/ARC3-Inference/inference/agent/r1_recovery.py
new file mode 100644
index 0000000..99f6406
--- /dev/null
+++ b/ARC3-Inference/inference/agent/r1_recovery.py
@@ -0,0 +1,380 @@
+"""R1 recovery pilot: per-object flags, probe notice, prelude seeding, timeout report.
+
+Every behaviour change in the R1 patch is gated by one of the flags below. A flag
+is read from the object's ``_r1_flags`` dict when present (so arms can differ
+between concurrently running sessions in one process) and from the environment
+otherwise. With no flag set the patched harness behaves as the P0 harness.
+
+  ARC3_R1_PROBE_NOTICE   1      A1: one-time notice prepended to the first opener
+  ARC3_R1_BATCH_CAP      6      A1: action batches capped until a read-back
+  ARC3_R1_TOOL_TIMEOUT   120    A2: python tool timeout in seconds (P0: 30)
+  ARC3_R1_TIMEOUT_CANCEL 1      A2: cancel queued actions at the tool timeout,
+                                keep retained functions, report what ran
+  ARC3_R1_FRESH_START    1      A3 (R1b): the restored conversation and prelude
+                                are not loaded; one context line is prepended
+                                to the first opener
+  ARC3_R1_TRIM_RESTORE   1      A4 (R1c): the restored conversation is cut to
+                                its most recent TRIM_KEEP_FRACTION of messages
+                                (the share P0's own trims kept), aligned to a
+                                user message; retained functions kept; no notice
+  ARC3_R1_NO_PRELUDE     1      A5 (R1c): the prelude is not run and no
+                                retained functions are seeded; conversation
+                                restored in full; no notice
+  ARC3_R1_REPERTOIRE     1      A6 (R1e): the repertoire sweep, a message
+                                listing the action effects observed in this
+                                game (inference.agent.r1_repertoire) and asking
+                                for untested uses of them; prepended to the
+                                first opener after the restore point and again
+                                every 25 actions on a level not yet cleared
+"""
+from __future__ import annotations
+
+import math
+import os
+from typing import Any
+
+PROBE_NOTICE = (
+    "Your model of this level has been contradicted at least once. Before any plan "
+    "longer than 6 actions: name the two hypotheses that explain the last contradiction, "
+    "run a probe of at most 6 actions that distinguishes them, read back the board, state "
+    "which hypothesis survived. Repeat until a prediction holds."
+)
+
+PROBE_BATCH_SIZE = 6
+
+# A4 dose: the share of history messages one P0 trim keeps. Source: the 87 trims
+# recorded in the failure-annotation dossiers (experiments/arc3-failure-annotation/
+# dossiers/*.md, "sNN: before->after"): median 87 -> 39 messages, median kept
+# share 0.45 (pooled 0.45).
+TRIM_KEEP_FRACTION = 0.45
+
+FRESH_NOTICE = "This game is in progress: level {level} of {n_levels}, {actions} actions taken so far."
+
+FLAG_NAMES = (
+    "ARC3_R1_PROBE_NOTICE",
+    "ARC3_R1_BATCH_CAP",
+    "ARC3_R1_TOOL_TIMEOUT",
+    "ARC3_R1_TIMEOUT_CANCEL",
+    "ARC3_R1_FRESH_START",
+    "ARC3_R1_TRIM_RESTORE",
+    "ARC3_R1_NO_PRELUDE",
+    "ARC3_R1_REPERTOIRE",
+)
+
+# R1: A0, A1, A2. R1b: A0b (a second sample of A0) and A3 (fresh continuation).
+# R1c: A4 (restored conversation after one P0-sized trim, functions kept) and
+# A5 (full restored conversation, no retained functions). R1d: A0L (A0 with a
+# doubled budget). R1e: A6 (repertoire sweep) and A0c (a third sample of A0).
+ARM_FLAGS: dict[str, dict[str, str]] = {
+    "A0": {},
+    "A1": {"ARC3_R1_PROBE_NOTICE": "1", "ARC3_R1_BATCH_CAP": str(PROBE_BATCH_SIZE)},
+    "A2": {"ARC3_R1_TOOL_TIMEOUT": "120", "ARC3_R1_TIMEOUT_CANCEL": "1"},
+    "A0b": {},
+    "A3": {"ARC3_R1_FRESH_START": "1"},
+    "A4": {"ARC3_R1_TRIM_RESTORE": "1"},
+    "A5": {"ARC3_R1_NO_PRELUDE": "1"},
+    "A0L": {},
+    "A6": {"ARC3_R1_REPERTOIRE": "1"},
+    "A0c": {},
+}
+
+
+def fresh_notice(level: Any, n_levels: Any, actions: Any) -> str:
+    return FRESH_NOTICE.format(level=level, n_levels=n_levels if n_levels is not None else "?", actions=actions)
+
+
+def r1_flag(obj: Any, name: str, default: str = "") -> str:
+    flags = getattr(obj, "_r1_flags", None)
+    if isinstance(flags, dict) and name in flags:
+        return str(flags[name])
+    return os.environ.get(name, default)
+
+
+def r1_int(obj: Any, name: str, default: int = 0) -> int:
+    raw = r1_flag(obj, name, "").strip()
+    if not raw:
+        return default
+    try:
+        return int(float(raw))
+    except ValueError:
+        return default
+
+
+def r1_bool(obj: Any, name: str) -> bool:
+    return r1_flag(obj, name, "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def new_stats() -> dict[str, int]:
+    return {
+        "batches": 0,
+        "capped_batches": 0,
+        "probes": 0,
+        "readbacks": 0,
+        "timeouts": 0,
+        "cancelled_actions": 0,
+        "notice_shown": 0,
+        "fresh_notice_shown": 0,
+        "repertoire_shown": 0,
+        "repertoire_chars_max": 0,
+        "repertoire_errors": 0,
+    }
+
+
+def batch_cap_detail(cap: int, executed: int, requested: int) -> str:
+    return (
+        f"Batch capped at {cap} actions: actions {executed + 1}-{requested} of your list were NOT "
+        f"executed. The cap holds until you read back the board (a python call that inspects "
+        f"current_frame and executes no action); after a read-back one batch of any size is allowed."
+    )
+
+
+def timeout_report(timeout_seconds: int, executed: list[str], cancelled: list[str], kept_functions: bool) -> str:
+    def fmt(items: list[str]) -> str:
+        if not items:
+            return "none"
+        shown = ", ".join(items[:40])
+        if len(items) > 40:
+            shown += f", ... ({len(items)} total)"
+        return shown
+    text = (
+        f"Tool timed out after {timeout_seconds}s. Actions executed before the limit: {fmt(executed)} "
+        f"({len(executed)}). Actions cancelled at the limit and NOT executed: {fmt(cancelled)} "
+        f"({len(cancelled)}). The board reflects only the executed actions; re-read current_frame "
+        f"before planning."
+    )
+    if kept_functions:
+        text += " Your retained functions were kept."
+    return text
+
+
+def executed_displays(action_results: list[dict[str, Any]]) -> list[str]:
+    out: list[str] = []
+    for item in action_results:
+        if not isinstance(item, dict) or not item.get("executed"):
+            continue
+        names = item.get("executed_actions")
+        if isinstance(names, list) and names:
+            out.extend(str(n) for n in names)
+        else:
+            out.append(str(item.get("action_display") or item.get("action_name") or "?"))
+    return out
+
+
+def cancelled_displays(action_results: list[dict[str, Any]], host_cancelled: list[list[Any]]) -> list[str]:
+    out: list[str] = []
+    for item in action_results:
+        if isinstance(item, dict) and item.get("stop_reason") == "tool_timeout":
+            out.extend(str(n) for n in (item.get("skipped_actions") or []))
+    for batch in host_cancelled:
+        for a in batch:
+            if isinstance(a, dict):
+                name = a.get("action") or a.get("name") or "?"
+                if "row" in a or "col" in a or "x" in a or "y" in a:
+                    row = a.get("row", a.get("y"))
+                    col = a.get("col", a.get("x"))
+                    out.append(f"{name}(row={row}, col={col})")
+                else:
+                    out.append(str(name))
+            else:
+                out.append(str(a))
+    return out
+
+
+def seed_kept_functions(prelude_code: str, *, timeout_seconds: int = 30) -> tuple[dict[str, str], str]:
+    """Run the prelude once in the sandbox with actions refused; return name->source.
+
+    Best effort: the sandbox's own retention policy decides what survives, the
+    same policy that produced P0's retained set turn by turn.
+    """
+    from inference.agent.python_tool_sandbox import run_sandboxed_python
+    from inference.utils.retained_functions import function_signature
+
+    if not prelude_code.strip():
+        return {}, ""
+
+    def refuse(actions, stale_after=None):  # noqa: ANN001
+        raise RuntimeError("actions are not available while seeding the prelude")
+
+    result = run_sandboxed_python(
+        code=prelude_code,
+        timeout_seconds=timeout_seconds,
+        initial_state={"current_frame": None, "history": [], "valid_actions": [],
+                       "death_ledger": None, "last_action_call_result": {}},
+        action_handler=refuse,
+        animation_handler=None,
+        kept_functions=[],
+        retain_imports=True,
+        repair_hints=False,
+    )
+    kept: dict[str, str] = {}
+    for item in result.get("keepable_functions") or []:
+        try:
+            name, source = item["name"], item["source"]
+            if function_signature(source).split("(", 1)[0] == name:
+                kept[name] = source
+        except Exception:  # noqa: BLE001
+            continue
+    return kept, str(result.get("error") or "")
+
+
+def restore_agent(agent: Any, state_path, history: list[dict[str, Any]], kept: dict[str, str], *,
+                  actions_at_level_start: int = 0) -> None:
+    """Put a fresh ToolAgent into the state P0 had at the restore point.
+
+    With an empty ``history`` and ``kept`` (A3) the agent starts a new
+    conversation on the replayed board.
+    """
+    agent._ensure_session(state_path)
+    agent._history_messages = [dict(m) for m in history]
+    agent._kept_functions = dict(kept)
+    agent._retained_clear_notice = ""
+    agent._actions_at_level_start = int(actions_at_level_start)
+    agent._tokens_at_level_start = 0
+    agent._r1_probe_notice_pending = True
+    agent._r1_fresh_notice_pending = True
+    agent._r1_repertoire_pending = True
+
+
+def repertoire_notice(agent: Any, history_entries: list[Any], step_env: Any = None) -> str:
+    """A6: the repertoire sweep when one is due, else "".
+
+    Due at the first opener after the restore point (``restore_agent`` arms it)
+    and again once SWEEP_EVERY more actions have been taken on the current
+    level since the last sweep; on a level change the count starts again, so
+    without a restore the first sweep comes after SWEEP_EVERY actions on a
+    level. The observations come from the session's events log (its viewer
+    events; the runtime-state history when there is no session) and the
+    conversation. A failure is counted and yields no message.
+    """
+    if not r1_bool(agent, "ARC3_R1_REPERTOIRE"):
+        return ""
+    from inference.agent import r1_repertoire as rep
+
+    try:
+        session = getattr(step_env, "__self__", None)
+        events = getattr(session, "viewer_events", None)
+        records = rep.records_from_events(events) if events else rep.records_from_history(history_entries)
+        if not records:
+            return ""
+        level = int(records[-1]["level"])
+        n = rep.actions_on_level(records)
+        if getattr(agent, "_r1_repertoire_level", None) != level:
+            agent._r1_repertoire_level = level
+            agent._r1_repertoire_last = None
+        last = getattr(agent, "_r1_repertoire_last", None)
+        due = bool(getattr(agent, "_r1_repertoire_pending", False)) or (
+            n >= rep.SWEEP_EVERY if last is None else n - int(last) >= rep.SWEEP_EVERY
+        )
+        if not due:
+            return ""
+        text = rep.sweep_message(records, list(getattr(agent, "_history_messages", None) or []))
+    except Exception:  # noqa: BLE001
+        agent._r1_stats["repertoire_errors"] += 1
+        agent._r1_repertoire_pending = False
+        return ""
+    agent._r1_repertoire_pending = False
+    agent._r1_repertoire_last = n
+    agent._r1_stats["repertoire_shown"] += 1
+    agent._r1_stats["repertoire_chars_max"] = max(int(agent._r1_stats["repertoire_chars_max"]), len(text))
+    return text
+
+
+def _history_tokens(agent: Any, tools: list[dict[str, Any]], history: list[dict[str, Any]]) -> int:
+    system = {"role": "system", "content": agent._system_prompt}
+    return int(agent._estimate_request_input_tokens([system, *history], tools=tools))
+
+
+def trim_restored_history(agent: Any, state_path, keep_fraction: float = TRIM_KEEP_FRACTION) -> dict[str, Any]:
+    """A4: cut the restored conversation to the share of messages one P0 trim keeps.
+
+    Keeps the most recent ceil(keep_fraction * n) messages, applies the turn cap
+    as ``_persistent_history_messages`` does (150 / drain 30 in P0; does not bind
+    on the restored histories), then aligns the start to a user message with the
+    harness's ``_drop_until_first_user_message``. If that alignment would leave no
+    message at all, the cut moves back to the last user message before it (P0's
+    trimmer never drops the last user message either). Called after
+    ``restore_agent``; returns the sizes before and after (messages, and the
+    request estimate in tokens for the record).
+    """
+    from inference.agent import tool_agent as _ta
+
+    agent._ensure_session(state_path)
+    tools = agent._tools(state_path)
+    history = list(agent._history_messages)
+    n = len(history)
+    n_keep = min(n, int(math.ceil(float(keep_fraction) * n - 1e-9)))
+    start = n - n_keep
+    kept = agent._keep_recent_history_turns(
+        history[start:],
+        max_turns=_ta._persistent_history_assistant_turns(),
+        drain_turns=_ta._history_turn_drain(),
+        force_drain=n_keep < n and _ta._history_drain_coalesce(),
+    )
+    kept = agent._drop_until_first_user_message(kept)
+    backed_off = False
+    if not kept and n:
+        users = [i for i in range(min(start, n - 1), -1, -1) if str(history[i].get("role", "")).strip() == "user"]
+        if users:
+            kept = history[users[0]:]
+            backed_off = True
+    tokens_before = _history_tokens(agent, tools, history)
+    if len(kept) < n:
+        agent._note_history_evicted()
+    agent._history_messages = kept
+    return {
+        "messages_before": n,
+        "messages_after": len(kept),
+        "keep_fraction": float(keep_fraction),
+        "keep_messages": n_keep,
+        "backed_off": backed_off,
+        "tokens_before": tokens_before,
+        "tokens_after": _history_tokens(agent, tools, kept),
+    }
+
+
+def trim_restored_history_tokens(agent: Any, state_path) -> dict[str, int]:
+    """Token-target variant (not used by any arm): reduce the restored
+    conversation as one P0 context trim would, to P0's post-trim token target.
+
+    P0 trims in ``ToolAgent._trim_messages_for_context``: once the request
+    estimate exceeds the budget (context window minus max output minus the
+    safety margin: 131072 - 12288 - 512 = 118272 in P0) it drops the oldest
+    history blocks until the estimate is at or below the budget minus the drain,
+    where the drain is ARC3_CONTEXT_DRAIN_TOKENS capped at half the budget
+    (P0: min(59392, 59136) = 59136, so the target is 59136 estimated tokens);
+    the turn cap then runs with the coalesced drain
+    (``_persistent_history_messages``; 150 - 30 = 120 assistant messages in P0). Here the same two functions run on
+    [system, *restored history] with ``force_drain=True``, which enters the
+    drain directly, so the history ends at the post-trim target whatever its
+    size. A history already at or below the target is left as it is.
+    Called after ``restore_agent``; returns the sizes before and after.
+    """
+    from inference.agent import tool_agent as _ta
+
+    agent._ensure_session(state_path)
+    tools = agent._tools(state_path)
+    system = {"role": "system", "content": agent._system_prompt}
+    history = list(agent._history_messages)
+    messages = [system, *history]
+    budget = int(agent._context_budget_tokens)
+    drain = min(_ta._context_drain_tokens(), budget // 2)
+    target = max(1, budget - drain) if drain else budget
+    before_tokens = agent._estimate_request_input_tokens(messages, tools=tools)
+    trimmed = agent._trim_messages_for_context(messages, tools=tools, force_drain=True)[1:]
+    kept = agent._keep_recent_history_turns(
+        trimmed,
+        max_turns=_ta._persistent_history_assistant_turns(),
+        drain_turns=_ta._history_turn_drain(),
+        force_drain=len(trimmed) < len(history) and _ta._history_drain_coalesce(),
+    )
+    kept = agent._drop_until_first_user_message(kept)
+    agent._history_messages = kept
+    after_tokens = agent._estimate_request_input_tokens([system, *kept], tools=tools)
+    return {
+        "messages_before": len(history),
+        "messages_after": len(kept),
+        "tokens_before": int(before_tokens),
+        "tokens_after": int(after_tokens),
+        "target_tokens": int(target),
+        "budget_tokens": budget,
+    }
diff --git a/ARC3-Inference/inference/agent/r1_repertoire.py b/ARC3-Inference/inference/agent/r1_repertoire.py
